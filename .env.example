# 复制为 .env 后填写；.env 不会提交到 Git
# start_server.bat / start_server.sh 会自动把这里的配置加载为环境变量
FLASK_ENV=development
# 生产环境必须设置为至少32字节的随机字符串；同时用于派生 OTP 密钥与 SMTP 密码的加密密钥，
# 更换后所有已绑定 OTP 失效（需重新绑定）、SMTP 密码需在本机维护页重新录入
SECRET_KEY=请替换为至少32字节的随机字符串
# 相对 sqlite 路径按项目根目录解析
DATABASE_URL=sqlite:///instance/credit_system.db
JWT_EXPIRES_SECONDS=43200
# 开发期放行 Vite dev server；生产同源部署可留空
CORS_ORIGINS=http://localhost:5173
