# 复制为 .env 后填写；.env 不会提交到 Git
FLASK_ENV=development
# 生产环境必须设置为至少32字节的随机字符串；同时用于派生 SMTP 密码加密密钥，
# 更换后需在管理端重新录入 SMTP 密码
SECRET_KEY=请替换为至少32字节的随机字符串
DATABASE_URL=sqlite:///instance/credit_system.db
JWT_EXPIRES_SECONDS=43200
# 开发期放行 Vite dev server；生产同源部署可留空
CORS_ORIGINS=http://localhost:5173
# init_admin.py 非交互模式下使用的初始密码（可选，默认 sysadmin）
# INIT_ADMIN_PASSWORD=
